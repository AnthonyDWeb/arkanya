{
  "name": "@arkanya/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "db:migrate": "tsx scripts/with-env.ts prisma migrate dev",
    "db:seed": "tsx scripts/with-env.ts tsx prisma/seed.ts",
    "db:studio": "tsx scripts/with-env.ts prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0"
  },
  "devDependencies": {
    "@arkanya/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
